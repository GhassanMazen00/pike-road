[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="interactable"
3d_physics/layer_3="surface"
3d_physics/layer_4="player"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[rendering]

textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/positional_shadow/atlas_size=4096
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/defaults/default_clear_color=Color(0.01, 0.012, 0.018, 1)
